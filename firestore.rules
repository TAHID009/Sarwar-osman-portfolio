rules_version = '2';
// AeroOps company-level rules. UNTESTED against the Firebase emulator: review in the Rules Playground before publishing.
service cloud.firestore {
  match /databases/{db}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'mdsarwar.osman.ft@gmail.com';
    }
    function hasCompany(d) { return d.companyId is string && d.companyId.size() > 0 && d.companyId.size() <= 64; }
    function wsPath(id) { return /databases/$(db)/documents/work_record_workspaces/$(id); }
    function wsOpen(id) { return !exists(wsPath(id)) || get(wsPath(id)).data.archived != true; }
    // companyId is immutable once set (no transfer between companies); legacy records without one may be stamped once.
    function companyKept() {
      return !('companyId' in resource.data) || resource.data.companyId == request.resource.data.companyId;
    }
    match /work_record_workspaces/{id} {
      allow read: if owner();
      allow create: if owner() && request.resource.data.id == id && request.resource.data.name is string;
      allow update: if owner() && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }
    match /work_record_entries/{doc} {
      allow read, delete: if owner();
      allow create: if owner() && hasCompany(request.resource.data) && wsOpen(request.resource.data.companyId);
      allow update: if owner() && hasCompany(request.resource.data) && companyKept() && wsOpen(request.resource.data.companyId);
    }
    match /work_record_sales/{doc} {
      allow read, delete: if owner();
      allow create: if owner() && hasCompany(request.resource.data) && wsOpen(request.resource.data.companyId);
      allow update: if owner() && hasCompany(request.resource.data) && companyKept() && wsOpen(request.resource.data.companyId);
    }
    match /work_record_pwi/{doc} {
      allow read, delete: if owner();
      allow create: if owner() && hasCompany(request.resource.data) && wsOpen(request.resource.data.companyId);
      allow update: if owner() && hasCompany(request.resource.data) && companyKept() && wsOpen(request.resource.data.companyId);
    }
    // existing homepage counters: keep your current rule if different (public read, owner write assumed)
    match /public_stats/{doc} { allow read: if true; allow write: if owner(); }
  }
}
